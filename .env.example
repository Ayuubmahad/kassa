# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# --- Database ---
# When running the app inside docker compose, host is "db".
# When running the app on your machine against the compose Postgres, host is "localhost".
DATABASE_URL=postgres://kassa:kassa@localhost:5432/kassa

# Max connections in the pg pool. Tune for load tests (Postgres default max is 100).
DB_POOL_MAX=20
